# ============================================================================
# 服务器部署配置（入库版）—— APP_ENV=server 时加载（config.py 自动切换）
# 本地开发用 .env（gitignored）。键名与 config.py 的 Settings 字段一一对应
# （大写蛇形 = 小写蛇形，pydantic-settings 自动映射）。
# 本文件只放"部署环境差异"：内网地址/端口。模型/算法参数保持代码默认，不改这里。
# ============================================================================

# 后端监听端口（前端 dev/preview 代理与日常约定都是 8010）
SERVER_HOST=0.0.0.0
SERVER_PORT=8010

# GPU 语音服务（diarize_svc：ASR+认人+声纹库；IP 会变，变了改这里）
DIARIZE_HTTP_URL=http://172.16.16.120:10096

# LLM 网关（内网 mymodule vLLM 网关；chat=256k 池 / new=1M 多模态池）
LLM_BASE_URL=http://127.0.0.1:4000/v1
LLM_MODEL=chat
LLM_TIMEOUT_SEC=300

# 数据库与产物目录（相对 server/ 运行目录）
DATABASE_URL=mysql+asyncmy://meeting:CHANGE_ME@127.0.0.1:3306/meeting_asr?charset=utf8mb4
RECORDINGS_DIR=./recordings

# 热词（大词库 5k 日频 + 企业补充词；逗号分隔追加）
HOTWORDS_FILE=./hotwords/dict_daily5k.txt
HOTWORDS_EXTRA=
