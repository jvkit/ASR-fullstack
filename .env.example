# 本地开发配置模板（复制为 .env 后按本机情况改；.env 已被 gitignore）
# 键名与 config.py Settings 字段一一对应。不配的项回落到代码默认值。
# 服务器部署用 .env.server（APP_ENV=server 自动切换，入库）。

# 后端
SERVER_HOST=0.0.0.0
SERVER_PORT=8010

# GPU 语音服务（diarize_svc：ASR + 认人 + 声纹库）
DIARIZE_HTTP_URL=http://172.16.16.120:10096

# LLM 网关
LLM_BASE_URL=http://127.0.0.1:4000/v1
LLM_MODEL=chat
LLM_TIMEOUT_SEC=300

# Langfuse 追踪（可选，默认关）
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# 数据库 / 录音目录
DATABASE_URL=sqlite+aiosqlite:///./meeting.db
RECORDINGS_DIR=./recordings

# 热词
HOTWORDS_FILE=./hotwords/dict_daily5k.txt
HOTWORDS_EXTRA=
