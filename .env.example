# ===== 总结调度 =====
SUMMARY_INTERVAL_SEC=60        # 定时总结间隔（秒）
SUMMARY_MIN_UTTERANCES=3       # 窗口内最少句子数，不足则跳过
SUMMARY_MAX_CHARS=1500         # 单次送入 LLM 的文本上限（字）
ATTR_TRIGGER_CHARS=800         # 事实性属性提取触发阈值（累计字数）
